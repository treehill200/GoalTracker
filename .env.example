# Goal Tracker environment variables.
# Copy to .env.local and fill in what you need. EVERYTHING IS OPTIONAL:
# with no variables at all the app runs in demo mode (data in your browser,
# rule-based coach and log parser).

# ---------------------------------------------------------------- Supabase
# Optional. Enables accounts (magic link + Google), cloud sync and partner sharing.
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional, server-only. Needed for: deleting accounts, the Apple Health webhook,
# Strava token storage per user, and background push (cron). NEVER expose this.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Set to 0 to hide the "Continue with Google" button (if you haven't
# enabled the Google provider in Supabase → Authentication → Providers).
NEXT_PUBLIC_GOOGLE_AUTH=1

# ---------------------------------------------------------------------- AI
# Optional. Enables the AI goal breakdown, natural-language log parsing,
# streaming coach chat and weekly-review suggestions. Calls happen server-side only.
# "anthropic" (default) or "openai"
AI_PROVIDER=anthropic
# Optional. Model id for the chosen provider (default claude-sonnet-5-5 for Anthropic, gpt-4.1-mini for OpenAI).
AI_MODEL=claude-sonnet-5-5
# Required only for the provider you picked.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --------------------------------------------------------------- Web Push
# Optional. Background push notifications. Generate with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional. Contact for push services (mailto: or https: URL).
VAPID_SUBJECT=mailto:you@example.com
# Optional. Protects /api/cron/notify (Vercel Cron sends it as a Bearer token automatically).
CRON_SECRET=

# ----------------------------------------------------------- Integrations
# Optional. Real Strava OAuth (https://www.strava.com/settings/api).
# Authorization Callback Domain: your domain (or localhost).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional but recommended in production: any long random string used to
# encrypt OAuth tokens at rest (AES-256-GCM). Falls back to STRAVA_CLIENT_SECRET.
INTEGRATION_ENCRYPTION_KEY=
# Optional. Shows the (stubbed) Plaid bank-sync card. See lib/integrations/plaid.ts.
PLAID_ENABLED=0

# ----------------------------------------------------------------- Testing
# Optional. Forces demo mode even if keys are present (used by the e2e test).
DEMO_FORCE=0
